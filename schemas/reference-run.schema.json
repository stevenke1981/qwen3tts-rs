{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Qwen3TTS Reference Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "source",
    "revision",
    "model",
    "case_id",
    "argv",
    "exit_status",
    "artifacts",
    "stages"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "official-python",
        "qwentts.cpp"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "official-python",
        "qwentts.cpp"
      ]
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": [
        "integer",
        "null"
      ]
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exit_status": {
      "type": "integer"
    },
    "artifacts": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/Artifact"
      }
    },
    "stages": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/Stage"
      }
    }
  },
  "definitions": {
    "Artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "relative_path",
        "byte_length",
        "sha256"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "prompt",
            "token",
            "stdout",
            "stderr",
            "tensor",
            "audio"
          ]
        },
        "relative_path": {
          "type": "string",
          "pattern": "^[^<>:\"|?*\\\\]+(?:[\\\\/][^<>:\"|?*\\\\]+)*$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "dtype": {
          "type": "string",
          "const": "f32"
        },
        "layout": {
          "type": "string",
          "const": "C"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "tensor"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["shape", "dtype", "layout"]
          }
        }
      ]
    },
    "Stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "dtype",
        "shape",
        "file",
        "layout",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "dtype": {
          "type": "string",
          "const": "f32"
        },
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+_\\d{4}\\.f32\\.bin$"
        },
        "layout": {
          "type": "string",
          "const": "C"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
